diff --git a/src/features/kalolsavam/components/KalolsavamUserFormDialog.tsx b/src/features/kalolsavam/components/KalolsavamUserFormDialog.tsx
new file mode 100644
index 0000000..9887a0a
--- /dev/null
+++ b/src/features/kalolsavam/components/KalolsavamUserFormDialog.tsx
@@ -0,0 +1,364 @@
+import { useState, useEffect } from "react";
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "../../../components/ui/dialog";
+import { Button } from "../../../components/ui/button";
+import { Input } from "../../../components/ui/input";
+import { Label } from "../../../components/ui/label";
+import { Checkbox } from "../../../components/ui/checkbox";
+import { Switch } from "../../../components/ui/switch";
+import { KalolsavamUser, KalolsavamStage, KalolsavamProgram } from "../types";
+import { createKalolsavamUser, updateKalolsavamUser, updateStage } from "../services/kalolsavamService";
+import { toast } from "sonner";
+import { Loader2, ShieldCheck, Eye, EyeOff, Lock, Mail } from "lucide-react";
+
+interface KalolsavamUserFormDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  user: KalolsavamUser | null;
+  stages: KalolsavamStage[];
+  programs: KalolsavamProgram[];
+}
+
+export function KalolsavamUserFormDialog({
+  open,
+  onOpenChange,
+  user,
+  stages,
+  programs,
+}: KalolsavamUserFormDialogProps) {
+  const [name, setName] = useState("");
+  const [email, setEmail] = useState("");
+  const [password, setPassword] = useState("");
+  const [showPassword, setShowPassword] = useState(false);
+  const [phone, setPhone] = useState("");
+  const [assignedStageIds, setAssignedStageIds] = useState<string[]>([]);
+  const [assignedProgramIds, setAssignedProgramIds] = useState<string[]>([]);
+  const [isActive, setIsActive] = useState(true);
+  const [loading, setLoading] = useState(false);
+
+  useEffect(() => {
+    if (user) {
+      setName(user.name || "");
+      setEmail(user.email || "");
+      setPassword("");
+      setPhone(user.phone || "");
+      setAssignedStageIds(user.assignedStageIds || []);
+      setAssignedProgramIds(user.assignedProgramIds || []);
+      setIsActive(user.isActive ?? true);
+    } else {
+      setName("");
+      setEmail("");
+      setPassword("");
+      setPhone("");
+      setAssignedStageIds([]);
+      setAssignedProgramIds([]);
+      setIsActive(true);
+    }
+  }, [user, open]);
+
+  const toggleStage = (stageId: string) => {
+    setAssignedStageIds((prev) => {
+      const exists = prev.includes(stageId);
+      if (exists) {
+        return prev.filter((id) => id !== stageId);
+      } else {
+        return [...prev, stageId];
+      }
+    });
+
+    // Also clean up programs if stage was removed
+    setAssignedProgramIds((prev) => {
+      const stageProgIds = programs.filter((p) => p.stageId === stageId).map((p) => p.id);
+      return prev.filter((id) => !stageProgIds.includes(id));
+    });
+  };
+
+  const toggleProgram = (progId: string) => {
+    setAssignedProgramIds((prev) => {
+      if (prev.includes(progId)) {
+        return prev.filter((id) => id !== progId);
+      } else {
+        return [...prev, progId];
+      }
+    });
+  };
+
+  // Filter programs that belong to the currently selected stages
+  const relevantPrograms = programs.filter((p) => assignedStageIds.includes(p.stageId));
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!name.trim()) {
+      toast.error("Please enter the user's name");
+      return;
+    }
+    if (!email.trim()) {
+      toast.error("Please enter a login email");
+      return;
+    }
+    if (!user && (!password.trim() || password.length < 6)) {
+      toast.error("Please provide a password of at least 6 characters");
+      return;
+    }
+    if (assignedStageIds.length === 0) {
+      toast.error("Please assign at least one stage to this stage manager");
+      return;
+    }
+
+    const assignedStageNames = stages
+      .filter((s) => assignedStageIds.includes(s.id))
+      .map((s) => s.name);
+
+    const assignedProgramNames = programs
+      .filter((p) => assignedProgramIds.includes(p.id))
+      .map((p) => p.title);
+
+    setLoading(true);
+    try {
+      if (user) {
+        await updateKalolsavamUser(user.id, {
+          name: name.trim(),
+          email: email.trim(),
+          phone: phone.trim(),
+          assignedStageIds,
+          assignedStageNames,
+          assignedProgramIds,
+          assignedProgramNames,
+          isActive,
+        });
+
+        // Sync stage documents' assignedUserIds
+        for (const stage of stages) {
+          const isAssigned = assignedStageIds.includes(stage.id);
+          const currentList = stage.assignedUserIds || [];
+          if (isAssigned && !currentList.includes(user.id)) {
+            await updateStage(stage.id, { assignedUserIds: [...currentList, user.id] });
+          } else if (!isAssigned && currentList.includes(user.id)) {
+            await updateStage(stage.id, { assignedUserIds: currentList.filter((id) => id !== user.id) });
+          }
+        }
+
+        toast.success("Stage manager updated successfully!");
+      } else {
+        const newUserId = await createKalolsavamUser(
+          {
+            name: name.trim(),
+            email: email.trim(),
+            phone: phone.trim(),
+            role: "stage_manager",
+            assignedStageIds,
+            assignedStageNames,
+            assignedProgramIds,
+            assignedProgramNames,
+            isActive,
+          },
+          password.trim()
+        );
+
+        // Add user to stages
+        for (const stageId of assignedStageIds) {
+          const stage = stages.find((s) => s.id === stageId);
+          if (stage) {
+            const currentList = stage.assignedUserIds || [];
+            await updateStage(stageId, { assignedUserIds: [...currentList, newUserId] });
+          }
+        }
+
+        toast.success("Stage manager account created successfully with email & password!");
+      }
+      onOpenChange(false);
+    } catch (err: any) {
+      console.error(err);
+      toast.error(err?.message || "Failed to save stage manager account");
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-[560px] max-h-[90vh] overflow-y-auto">
+        <form onSubmit={handleSubmit}>
+          <DialogHeader>
+            <DialogTitle className="flex items-center gap-2">
+              <ShieldCheck className="w-5 h-5 text-primary" />
+              {user ? "Edit Stage Manager" : "Create Stage Manager User"}
+            </DialogTitle>
+          </DialogHeader>
+
+          <div className="space-y-4 py-4">
+            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
+              <div className="space-y-2">
+                <Label htmlFor="usr-name">Full Name *</Label>
+                <Input
+                  id="usr-name"
+                  value={name}
+                  onChange={(e) => setName(e.target.value)}
+                  placeholder="e.g. Thomas George"
+                  required
+                />
+              </div>
+
+              <div className="space-y-2">
+                <Label htmlFor="usr-phone">Phone Number</Label>
+                <Input
+                  id="usr-phone"
+                  value={phone}
+                  onChange={(e) => setPhone(e.target.value)}
+                  placeholder="e.g. 9876543210"
+                />
+              </div>
+            </div>
+
+            {/* Email & Password Authentication Login Section */}
+            <div className="p-3.5 bg-muted/40 rounded-xl border border-border space-y-3">
+              <span className="text-xs font-bold uppercase tracking-wider text-primary block">
+                Mobile App Login Credentials
+              </span>
+
+              <div className="space-y-2">
+                <Label htmlFor="usr-email" className="text-xs font-semibold flex items-center gap-1.5">
+                  <Mail className="w-3.5 h-3.5" /> Login Email *
+                </Label>
+                <Input
+                  id="usr-email"
+                  type="email"
+                  value={email}
+                  onChange={(e) => setEmail(e.target.value)}
+                  placeholder="stagemanager@example.com"
+                  required
+                />
+              </div>
+
+              <div className="space-y-2">
+                <Label htmlFor="usr-pass" className="text-xs font-semibold flex items-center gap-1.5">
+                  <Lock className="w-3.5 h-3.5" /> Login Password {user ? "(Leave blank to keep existing)" : "*"}
+                </Label>
+                <div className="relative">
+                  <Input
+                    id="usr-pass"
+                    type={showPassword ? "text" : "password"}
+                    value={password}
+                    onChange={(e) => setPassword(e.target.value)}
+                    placeholder={user ? "••••••••" : "Minimum 6 characters"}
+                    className="pr-10"
+                    required={!user}
+                    minLength={6}
+                  />
+                  <button
+                    type="button"
+                    onClick={() => setShowPassword(!showPassword)}
+                    className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors"
+                  >
+                    {showPassword ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
+                  </button>
+                </div>
+                <p className="text-[11px] text-muted-foreground">
+                  The stage manager will use this email and password to log into the mobile app.
+                </p>
+              </div>
+            </div>
+
+            {/* Stages Assignment */}
+            <div className="space-y-2">
+              <Label className="font-semibold text-sm">
+                Assign Stage(s) to Manage *
+              </Label>
+              <p className="text-xs text-muted-foreground">
+                Select which stage(s) this user has permission to control and update chest numbers for.
+              </p>
+              <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2 max-h-40 overflow-y-auto p-2 border rounded-md bg-background">
+                {stages.length === 0 ? (
+                  <p className="text-xs text-muted-foreground col-span-2 py-2">
+                    No stages created yet. Please create a stage first.
+                  </p>
+                ) : (
+                  stages.map((stage) => {
+                    const checked = assignedStageIds.includes(stage.id);
+                    return (
+                      <label
+                        key={stage.id}
+                        className={`flex items-center space-x-2.5 p-2 rounded-md border text-sm cursor-pointer select-none transition-colors ${
+                          checked
+                            ? "bg-primary/10 border-primary text-primary font-medium"
+                            : "bg-muted/20 border-border hover:bg-muted/40"
+                        }`}
+                      >
+                        <Checkbox
+                          checked={checked}
+                          onCheckedChange={() => toggleStage(stage.id)}
+                        />
+                        <span className="truncate">{stage.name}</span>
+                      </label>
+                    );
+                  })
+                )}
+              </div>
+            </div>
+
+            {/* Program Specific Assignment */}
+            {relevantPrograms.length > 0 && (
+              <div className="space-y-2">
+                <Label className="font-semibold text-sm">
+                  Assign Specific Programs (Optional)
+                </Label>
+                <p className="text-xs text-muted-foreground">
+                  Leave all unselected to grant control over ALL programs on the assigned stages.
+                </p>
+                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2 max-h-36 overflow-y-auto p-2 border rounded-md bg-background">
+                  {relevantPrograms.map((prog) => {
+                    const checked = assignedProgramIds.includes(prog.id);
+                    return (
+                      <label
+                        key={prog.id}
+                        className={`flex items-center space-x-2.5 p-2 rounded-md border text-xs cursor-pointer select-none transition-colors ${
+                          checked
+                            ? "bg-primary/10 border-primary text-primary font-medium"
+                            : "bg-muted/20 border-border hover:bg-muted/40"
+                        }`}
+                      >
+                        <Checkbox
+                          checked={checked}
+                          onCheckedChange={() => toggleProgram(prog.id)}
+                        />
+                        <span className="truncate">
+                          {prog.title} ({prog.category})
+                        </span>
+                      </label>
+                    );
+                  })}
+                </div>
+              </div>
+            )}
+
+            <div className="flex items-center justify-between p-3 border rounded-lg bg-muted/20">
+              <div>
+                <Label htmlFor="usr-active" className="cursor-pointer font-medium text-sm">
+                  Active Account
+                </Label>
+                <p className="text-xs text-muted-foreground">
+                  When deactivated, this manager cannot log in to update stages.
+                </p>
+              </div>
+              <Switch id="usr-active" checked={isActive} onCheckedChange={setIsActive} />
+            </div>
+          </div>
+
+          <DialogFooter>
+            <Button
+              type="button"
+              variant="outline"
+              onClick={() => onOpenChange(false)}
+              disabled={loading}
+            >
+              Cancel
+            </Button>
+            <Button type="submit" disabled={loading}>
+              {loading && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}
+              {user ? "Save Changes" : "Create User"}
+            </Button>
+          </DialogFooter>
+        </form>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/src/features/kalolsavam/components/LiveDisplayBoard.tsx b/src/features/kalolsavam/components/LiveDisplayBoard.tsx
