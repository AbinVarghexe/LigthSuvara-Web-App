+import { useState, useEffect } from "react";
+import {
+  KalolsavamSettings,
+  KalolsavamStage,
+  KalolsavamProgram,
+  KalolsavamUser,
+  KalolsavamResult,
+} from "../../features/kalolsavam/types";
+import {
+  subscribeKalolsavamSettings,
+  subscribeStages,
+  subscribePrograms,
+  subscribeKalolsavamUsers,
+  subscribeKalolsavamResults,
+  saveKalolsavamSettings,
+  toggleKalolsavamActive,
+  deleteStage,
+  deleteProgram,
+  deleteKalolsavamUser,
+  deleteKalolsavamResult,
+  toggleResultPublished,
+  toggleTotalResultPublished,
+  removeTotalResultPdf,
+} from "../../features/kalolsavam/services/kalolsavamService";
+import { StageFormDialog } from "../../features/kalolsavam/components/StageFormDialog";
+import { ProgramFormDialog } from "../../features/kalolsavam/components/ProgramFormDialog";
+import { KalolsavamUserFormDialog } from "../../features/kalolsavam/components/KalolsavamUserFormDialog";
+import { LiveStageControlDialog } from "../../features/kalolsavam/components/LiveStageControlDialog";
+import { ResultUploadDialog } from "../../features/kalolsavam/components/ResultUploadDialog";
+import { LiveDisplayBoard } from "../../features/kalolsavam/components/LiveDisplayBoard";
+import { Button } from "../../components/ui/button";
+import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "../../components/ui/card";
+import { Badge } from "../../components/ui/badge";
+import { Switch } from "../../components/ui/switch";
+import { Input } from "../../components/ui/input";
+import { Label } from "../../components/ui/label";
+import { Textarea } from "../../components/ui/textarea";
+import {
+  Trophy,
+  Radio,
+  Plus,
+  Edit2,
+  Trash2,
+  Users,
+  Layers,
+  FileUp,
+  FileText,
+  Sliders,
+  ExternalLink,
+  Megaphone,
+  MapPin,
+  Clock,
+  Eye,
+  Settings as SettingsIcon,
+  Sparkles,
+} from "lucide-react";
+import { toast } from "sonner";
+import { useAuth } from "../../context/AuthContext";
+
+export function Kalolsavam() {
+  const { currentUser } = useAuth();
+  const [settings, setSettings] = useState<KalolsavamSettings | null>(null);
+  const [stages, setStages] = useState<KalolsavamStage[]>([]);
+  const [programs, setPrograms] = useState<KalolsavamProgram[]>([]);
+  const [users, setUsers] = useState<KalolsavamUser[]>([]);
+  const [results, setResults] = useState<KalolsavamResult[]>([]);
+  const [loading, setLoading] = useState(true);
+
+  // Active top-level tab
+  const [activeTab, setActiveTab] = useState<
+    "live" | "stages_programs" | "managers" | "results" | "preview" | "settings"
+  >("live");
+
