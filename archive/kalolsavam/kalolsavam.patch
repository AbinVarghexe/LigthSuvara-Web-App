+import { Timestamp } from "firebase/firestore";
+
+export interface KalolsavamSettings {
+  id?: string;
+  isActive: boolean; // Controls whether Kalolsavam is visible to participants in app
+  festivalName: string;
+  academicYear?: string;
+  festivalDate?: string;
+  venue?: string;
+  announcement?: string;
+  totalResultPdfUrl?: string | null;
+  totalResultPdfName?: string | null;
+  totalResultTitle?: string;
+  isTotalResultPublished?: boolean;
+  totalResultUploadedAt?: Timestamp | any;
+  updatedAt?: Timestamp | any;
+}
+
+export type StageStatus = "active" | "break" | "completed" | "paused";
+
+export interface KalolsavamStage {
+  id: string;
+  name: string; // e.g., "Stage 1 - Main Auditorium"
+  shortCode?: string; // e.g., "STG-1"
+  location: string; // e.g., "Auditorium Hall, 1st Floor"
+  order: number;
+  status: StageStatus;
+  currentProgramId?: string | null;
+  currentProgramTitle?: string;
+  currentChestNumber?: string;
+  nextChestNumber?: string;
+  stageNote?: string; // e.g. "Chest numbers 12 to 18 please report to green room"
+  assignedUserIds: string[];
+  assignedUserNames?: string[];
+  lastUpdated?: Timestamp | any;
+  lastUpdatedBy?: string;
+}
+
+export type ProgramStatus = "upcoming" | "ongoing" | "completed" | "results_published";
+
+export interface KalolsavamProgram {
+  id: string;
+  title: string; // e.g., "Margamkali", "Bharatanatyam"
+  code?: string; // e.g., "PRG-101"
+  category: string; // e.g., "Sub-Junior", "Junior", "Senior", "General"
+  stageId: string; // The stage where this program takes place (one stage can handle multiple programs)
+  stageName?: string;
+  orderInStage: number; // 1, 2, 3...
+  scheduledTime?: string; // e.g. "10:00 AM"
+  totalParticipants?: number;
+  currentChestNumber?: string;
+  status: ProgramStatus;
+  resultPdfUrl?: string | null;
+  resultPdfName?: string | null;
+  resultUploadedAt?: Timestamp | any;
+  isResultPublished: boolean;
+  assignedUserIds?: string[];
+  createdAt?: Timestamp | any;
+  updatedAt?: Timestamp | any;
+}
+
+export interface KalolsavamUser {
+  id: string;
+  uid?: string;
+  name: string;
+  email?: string;
+  phone?: string;
+  role: "stage_manager";
+  assignedStageIds: string[];
+  assignedStageNames: string[];
+  assignedProgramIds: string[];
+  assignedProgramNames?: string[];
+  isActive: boolean;
+  createdAt?: Timestamp | any;
+  lastLoginAt?: Timestamp | any;
+}
+
+export type ResultType = "total" | "program";
+
+export interface KalolsavamResult {
+  id: string;
+  resultType?: ResultType;
+  programId?: string;
+  programTitle: string;
+  category?: string;
+  stageId?: string;
+  stageName?: string;
+  pdfUrl: string;
+  pdfName: string;
+  fileSize?: number;
+  isPublished: boolean;
+  remarks?: string;
+  uploadedAt: Timestamp | any;
+  uploadedBy?: string;
+}
