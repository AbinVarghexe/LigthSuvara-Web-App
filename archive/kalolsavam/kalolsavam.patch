+import { useState, useEffect } from "react";
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "../../../components/ui/dialog";
+import { Button } from "../../../components/ui/button";
+import { Input } from "../../../components/ui/input";
+import { Label } from "../../../components/ui/label";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "../../../components/ui/select";
+import { Textarea } from "../../../components/ui/textarea";
+import { KalolsavamStage, KalolsavamProgram, StageStatus } from "../types";
+import { updateStage, updateStageChestNumber } from "../services/kalolsavamService";
+import { toast } from "sonner";
+import { Loader2, Plus, Minus, Megaphone, Radio, Play, Pause, CheckCircle } from "lucide-react";
+
+interface LiveStageControlDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  stage: KalolsavamStage | null;
+  stagePrograms: KalolsavamProgram[];
+  updatedBy?: string;
+}
+
+export function LiveStageControlDialog({
+  open,
+  onOpenChange,
+  stage,
+  stagePrograms,
+  updatedBy = "Admin",
+}: LiveStageControlDialogProps) {
+  const [chestNumber, setChestNumber] = useState("");
+  const [nextChestNumber, setNextChestNumber] = useState("");
+  const [currentProgramId, setCurrentProgramId] = useState<string>("");
+  const [stageStatus, setStageStatus] = useState<StageStatus>("active");
+  const [stageNote, setStageNote] = useState("");
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    if (stage) {
+      setChestNumber(stage.currentChestNumber || "");
+      setNextChestNumber(stage.nextChestNumber || "");
+      setCurrentProgramId(stage.currentProgramId || (stagePrograms[0]?.id ?? ""));
+      setStageStatus(stage.status || "active");
+      setStageNote(stage.stageNote || "");
+    }
+  }, [stage, stagePrograms, open]);
+
+  if (!stage) return null;
+
+  // Quick increment/decrement chest number
+  const incrementChest = (delta: number) => {
+    const num = parseInt(chestNumber, 10);
+    if (!isNaN(num)) {
+      const nextVal = Math.max(0, num + delta);
+      setChestNumber(String(nextVal));
+      setNextChestNumber(String(nextVal + 1));
+    } else {
+      setChestNumber("1");
+      setNextChestNumber("2");
+    }
+  };
+
+  const handleSave = async () => {
+    setSaving(true);
+    try {
+      const selectedProg = stagePrograms.find((p) => p.id === currentProgramId);
+      const programTitle = selectedProg ? selectedProg.title : "";
+
+      await updateStageChestNumber(
+        stage.id,
+        chestNumber.trim() || "-",
+        nextChestNumber.trim() || "-",
+        stageNote.trim(),
+        currentProgramId || undefined,
+        updatedBy
+      );
+
+      await updateStage(stage.id, {
+        status: stageStatus,
+        currentProgramId: currentProgramId || null,
+        currentProgramTitle: programTitle,
+      });
+
+      toast.success("Live stage updated successfully!");
+      onOpenChange(false);
+    } catch (err: any) {
+      console.error(err);
+      toast.error(err?.message || "Failed to update stage");
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-[540px]">
+        <DialogHeader>
+          <div className="flex items-center justify-between">
+            <DialogTitle className="flex items-center gap-2 text-xl font-bold">
+              <span className="flex h-3 w-3 rounded-full bg-emerald-500 animate-ping" />
+              Live Control: {stage.name}
+            </DialogTitle>
+          </div>
+          <p className="text-xs text-muted-foreground">
+            Location: {stage.location || "Venue Stage"}
+          </p>
+        </DialogHeader>
+
+        <div className="space-y-5 py-3">
+          {/* Active Program Selection */}
+          <div className="space-y-2">
+            <Label className="text-sm font-semibold">Active Program on Stage</Label>
+            {stagePrograms.length === 0 ? (
+              <p className="text-xs text-amber-500">
+                No programs assigned to this stage yet. Add programs to this stage from the Programs tab.
+              </p>
+            ) : (
+              <Select value={currentProgramId} onValueChange={setCurrentProgramId}>
+                <SelectTrigger className="font-medium h-11">
+                  <SelectValue placeholder="Select active competition" />
+                </SelectTrigger>
+                <SelectContent>
+                  {stagePrograms.map((prog) => (
+                    <SelectItem key={prog.id} value={prog.id}>
+                      {prog.title} ({prog.category}) - {prog.scheduledTime || "Scheduled"}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+            )}
+          </div>
+
+          {/* Large Chest Number Modifier */}
+          <div className="p-4 bg-muted/40 rounded-xl border border-border space-y-3">
+            <div className="flex items-center justify-between">
+              <Label className="text-sm font-bold uppercase tracking-wider text-muted-foreground">
+                Current Chest Number on Stage
+              </Label>
+              <span className="text-xs text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
+                <Radio className="w-3.5 h-3.5" /> LIVE NOW
+              </span>
+            </div>
+
+            <div className="flex items-center justify-center gap-3">
+              <Button
+                type="button"
+                variant="outline"
+                size="icon"
+                onClick={() => incrementChest(-1)}
+                className="h-14 w-14 rounded-xl border-2 text-xl hover:bg-muted"
+              >
+                <Minus className="w-6 h-6" />
+              </Button>
+
+              <Input
+                value={chestNumber}
+                onChange={(e) => setChestNumber(e.target.value)}
+                placeholder="Chest #"
+                className="text-center font-bold text-3xl h-14 w-40 rounded-xl font-mono tracking-wider border-2 border-primary/50 focus:border-primary shadow-inner"
+              />
+
+              <Button
+                type="button"
+                variant="outline"
+                size="icon"
+                onClick={() => incrementChest(1)}
+                className="h-14 w-14 rounded-xl border-2 text-xl hover:bg-muted"
+              >
+                <Plus className="w-6 h-6" />
+              </Button>
+            </div>
+
+            <div className="pt-2 flex items-center justify-between border-t border-border/50 text-xs">
+              <span className="text-muted-foreground font-medium">Next to Perform / Reporting:</span>
+              <div className="flex items-center gap-2">
+                <Input
+                  value={nextChestNumber}
+                  onChange={(e) => setNextChestNumber(e.target.value)}
+                  placeholder="e.g. 15"
+                  className="h-8 w-24 text-center text-xs font-mono font-semibold"
+                />
+              </div>
+            </div>
+          </div>
+
+          {/* Stage Status Selector */}
+          <div className="grid grid-cols-2 gap-3">
+            <div className="space-y-1.5">
+              <Label className="text-xs font-semibold">Stage Status</Label>
+              <Select value={stageStatus} onValueChange={(val: StageStatus) => setStageStatus(val)}>
+                <SelectTrigger className="h-9">
+                  <SelectValue placeholder="Status" />
+                </SelectTrigger>
+                <SelectContent>
+                  <SelectItem value="active">
+                    <span className="flex items-center gap-2 text-emerald-600">
+                      <Play className="w-3.5 h-3.5" /> Active / Ongoing
+                    </span>
+                  </SelectItem>
+                  <SelectItem value="break">
+                    <span className="flex items-center gap-2 text-amber-600">
+                      <Pause className="w-3.5 h-3.5" /> On Short Break
+                    </span>
+                  </SelectItem>
+                  <SelectItem value="paused">
+                    <span className="flex items-center gap-2 text-blue-600">
+                      <Pause className="w-3.5 h-3.5" /> Paused
+                    </span>
+                  </SelectItem>
+                  <SelectItem value="completed">
+                    <span className="flex items-center gap-2 text-slate-500">
+                      <CheckCircle className="w-3.5 h-3.5" /> Stage Concluded
+                    </span>
+                  </SelectItem>
+                </SelectContent>
+              </Select>
+            </div>
+
+            <div className="space-y-1.5">
+              <Label className="text-xs font-semibold">Quick Stage Broadcast</Label>
+              <div className="flex gap-1.5">
+                <Button
+                  type="button"
+                  variant="outline"
+                  size="sm"
+                  className="text-[11px] h-9 px-2"
+                  onClick={() => setStageNote("Next 3 participants report to backstage")}
+                >
+                  Report Next 3
+                </Button>
+                <Button
+                  type="button"
+                  variant="outline"
+                  size="sm"
+                  className="text-[11px] h-9 px-2"
+                  onClick={() => setStageNote("10-minute break in progress")}
+                >
+                  10m Break
+                </Button>
+              </div>
+            </div>
+          </div>
+
+          {/* Stage Note */}
+          <div className="space-y-2">
+            <Label htmlFor="stage-notes" className="text-xs font-semibold flex items-center gap-1.5">
+              <Megaphone className="w-3.5 h-3.5 text-primary" />
+              Live Announcement Note for Participants
+            </Label>
+            <Textarea
+              id="stage-notes"
+              value={stageNote}
+              onChange={(e) => setStageNote(e.target.value)}
+              placeholder="e.g. Chest numbers 25 to 30 please report to green room. Judge evaluation underway."
+              rows={2}
+              className="text-xs resize-none"
+            />
+          </div>
+        </div>
+
+        <DialogFooter className="gap-2 sm:gap-0">
+          <Button
+            type="button"
+            variant="outline"
+            onClick={() => onOpenChange(false)}
+            disabled={saving}
+          >
+            Cancel
+          </Button>
+          <Button onClick={handleSave} disabled={saving} className="bg-primary hover:bg-primary/90">
+            {saving && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}
+            Broadcast Live Update
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
