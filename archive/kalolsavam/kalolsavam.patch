+++ b/src/features/kalolsavam/components/ResultUploadDialog.tsx
@@ -0,0 +1,335 @@
+import { useState, useEffect } from "react";
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "../../../components/ui/dialog";
+import { Button } from "../../../components/ui/button";
+import { Input } from "../../../components/ui/input";
+import { Label } from "../../../components/ui/label";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "../../../components/ui/select";
+import { Switch } from "../../../components/ui/switch";
+import { Textarea } from "../../../components/ui/textarea";
+import { KalolsavamProgram, KalolsavamStage } from "../types";
+import { uploadResultPdf, uploadTotalResultPdf } from "../services/kalolsavamService";
+import { toast } from "sonner";
+import { Loader2, FileUp, FileText, CheckCircle2, Trophy, ListOrdered } from "lucide-react";
+
+interface ResultUploadDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  programs: KalolsavamProgram[];
+  stages: KalolsavamStage[];
+  defaultProgramId?: string;
+  defaultResultType?: "total" | "program";
+  adminName?: string;
+}
+
+export function ResultUploadDialog({
+  open,
+  onOpenChange,
+  programs,
+  stages,
+  defaultProgramId,
+  defaultResultType = "total",
+  adminName = "Admin",
+}: ResultUploadDialogProps) {
+  const [resultType, setResultType] = useState<"total" | "program">(defaultResultType);
+  const [totalTitle, setTotalTitle] = useState("ആകെ ഫലം (Overall Championship / Total Points)");
+  const [selectedProgramId, setSelectedProgramId] = useState("");
+  const [selectedFile, setSelectedFile] = useState<File | null>(null);
+  const [remarks, setRemarks] = useState("");
+  const [isPublished, setIsPublished] = useState(true);
+  const [uploading, setUploading] = useState(false);
+
+  useEffect(() => {
+    if (defaultProgramId) {
+      setSelectedProgramId(defaultProgramId);
+      setResultType("program");
+    } else if (defaultResultType) {
+      setResultType(defaultResultType);
+      if (programs.length > 0) {
+        setSelectedProgramId(programs[0].id);
+      }
+    }
+    setSelectedFile(null);
+    setRemarks("");
+    setIsPublished(true);
+  }, [defaultProgramId, defaultResultType, programs, open]);
+
+  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
+    const file = e.target.files?.[0];
+    if (file) {
+      if (!file.name.toLowerCase().endsWith(".pdf") && file.type !== "application/pdf") {
+        toast.error("Please upload a PDF document (.pdf)");
+        return;
+      }
+      setSelectedFile(file);
+    }
+  };
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!selectedFile) {
+      toast.error("Please select a PDF file to upload");
+      return;
+    }
+
+    if (resultType === "total") {
+      if (!totalTitle.trim()) {
+        toast.error("Please enter a title for the Total Result");
+        return;
+      }
+
+      setUploading(true);
+      try {
+        await uploadTotalResultPdf(selectedFile, {
+          title: totalTitle.trim(),
+          isPublished,
+          remarks: remarks.trim(),
+          uploadedBy: adminName,
+        });
+
+        toast.success(`Overall / Total Result PDF published successfully!`);
+        onOpenChange(false);
+      } catch (err: any) {
+        console.error("Total Result upload error:", err);
+        toast.error(err?.message || "Failed to upload Total Result PDF");
+      } finally {
+        setUploading(false);
+      }
+      return;
+    }
+
+    // Individual Program Result
+    if (!selectedProgramId) {
+      toast.error("Please select a competition program");
+      return;
+    }
+
+    const program = programs.find((p) => p.id === selectedProgramId);
+    if (!program) {
+      toast.error("Selected program not found");
+      return;
+    }
+
+    const stage = stages.find((s) => s.id === program.stageId);
+
+    setUploading(true);
+    try {
+      await uploadResultPdf(selectedFile, {
+        programId: program.id,
+        programTitle: program.title,
+        category: program.category,
+        stageId: program.stageId,
+        stageName: stage?.name || program.stageName || "Main Stage",
+        isPublished,
+        remarks: remarks.trim(),
+        uploadedBy: adminName,
+      });
+
+      toast.success(`Result PDF for "${program.title}" published successfully!`);
+      onOpenChange(false);
+    } catch (err: any) {
+      console.error("Result upload error:", err);
+      toast.error(err?.message || "Failed to upload result PDF");
+    } finally {
+      setUploading(false);
+    }
+  };
+
+  const selectedProgram = programs.find((p) => p.id === selectedProgramId);
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-[520px]">
+        <form onSubmit={handleSubmit}>
+          <DialogHeader>
+            <DialogTitle className="flex items-center gap-2 text-lg">
+              <FileUp className="w-5 h-5 text-primary" />
+              Upload & Publish Competition Results
+            </DialogTitle>
+          </DialogHeader>
+
+          <div className="space-y-4 py-4">
+            {/* Mode Selector: Total Result vs Individual Program */}
+            <div className="space-y-2">
+              <Label className="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
+                Select Result Type *
+              </Label>
+              <div className="grid grid-cols-2 gap-2 p-1 bg-muted/40 rounded-xl border">
+                <button
+                  type="button"
+                  onClick={() => setResultType("total")}
+                  className={`flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-bold transition-all ${
+                    resultType === "total"
+                      ? "bg-amber-600 text-white shadow-xs"
+                      : "text-muted-foreground hover:text-foreground"
+                  }`}
+                >
+                  <Trophy className="w-4 h-4" />
+                  ആകെ ഫലം (Total Result)
+                </button>
+                <button
+                  type="button"
+                  onClick={() => setResultType("program")}
+                  className={`flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-bold transition-all ${
+                    resultType === "program"
+                      ? "bg-primary text-primary-foreground shadow-xs"
+                      : "text-muted-foreground hover:text-foreground"
+                  }`}
+                >
+                  <ListOrdered className="w-4 h-4" />
+                  മത്സരഫലം (By Program)
+                </button>
+              </div>
+            </div>
+
+            {/* Total Result Fields */}
+            {resultType === "total" && (
+              <div className="space-y-3 p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20">
+                <div className="flex items-center gap-2">
+                  <Trophy className="w-4 h-4 text-amber-600" />
+                  <span className="text-xs font-bold text-amber-800 dark:text-amber-300">
+                    Grand Championship / Overall Total Points Result
+                  </span>
+                </div>
+                <div className="space-y-1.5">
+                  <Label htmlFor="total-title" className="text-xs font-semibold">
+                    Result Sheet Title *
+                  </Label>
+                  <Input
+                    id="total-title"
+                    value={totalTitle}
+                    onChange={(e) => setTotalTitle(e.target.value)}
+                    placeholder="e.g. ആകെ ഫലം (Overall Points Table - Kalolsavam)"
+                    className="h-9 bg-background text-sm"
+                    required
+                  />
+                </div>
+                <p className="text-[11px] text-amber-700 dark:text-amber-300 leading-tight">
+                  This will publish a single consolidated points table / championship PDF for all participants to view in the app.
+                </p>
+              </div>
+            )}
+
+            {/* Individual Program Fields */}
+            {resultType === "program" && (
+              <div className="space-y-2">
+                <Label htmlFor="res-program">Select Competition Program *</Label>
+                {programs.length === 0 ? (
+                  <p className="text-xs text-amber-600 p-2.5 bg-amber-50 rounded-lg border border-amber-200">
+                    No programs added yet. You can use <strong>ആകെ ഫലം (Total Result)</strong> above to publish the overall points list!
+                  </p>
+                ) : (
+                  <>
+                    <Select value={selectedProgramId} onValueChange={setSelectedProgramId}>
+                      <SelectTrigger id="res-program" className="h-10">
+                        <SelectValue placeholder="Choose program" />
+                      </SelectTrigger>
+                      <SelectContent>
+                        {programs.map((prog) => (
+                          <SelectItem key={prog.id} value={prog.id}>
+                            {prog.title} ({prog.category}) - {prog.stageName || "Stage"}
+                          </SelectItem>
+                        ))}
+                      </SelectContent>
+                    </Select>
+                    {selectedProgram?.resultPdfUrl && (
+                      <p className="text-xs text-amber-600 flex items-center gap-1 mt-1">
+                        <CheckCircle2 className="w-3.5 h-3.5" />
+                        Note: A result PDF already exists for this program. Uploading a new one will replace it.
+                      </p>
+                    )}
+                  </>
+                )}
+              </div>
+            )}
+
+            {/* File Drag/Drop or Select */}
+            <div className="space-y-2">
+              <Label>Result Document (PDF format only) *</Label>
+              <div className="border-2 border-dashed border-border rounded-xl p-5 text-center hover:bg-muted/30 transition-colors cursor-pointer relative">
+                <input
+                  type="file"
+                  accept="application/pdf,.pdf"
+                  onChange={handleFileChange}
+                  className="absolute inset-0 opacity-0 cursor-pointer w-full h-full"
+                  required={!selectedFile}
+                />
+                <div className="flex flex-col items-center justify-center space-y-2">
+                  <div className="p-3 bg-primary/10 rounded-full text-primary">
+                    <FileText className="w-6 h-6" />
+                  </div>
+                  {selectedFile ? (
+                    <div>
+                      <p className="text-sm font-semibold text-foreground">{selectedFile.name}</p>
+                      <p className="text-xs text-muted-foreground">
+                        {(selectedFile.size / 1024 / 1024).toFixed(2)} MB - Click or drag to replace
+                      </p>
+                    </div>
+                  ) : (
+                    <div>
+                      <p className="text-sm font-medium text-foreground">
+                        Click or drag & drop the Result PDF here
+                      </p>
+                      <p className="text-xs text-muted-foreground">
+                        {resultType === "total"
+                          ? "Upload official total points sheet (.pdf)"
+                          : "Upload official score sheet / rank list (.pdf)"}
+                      </p>
+                    </div>
+                  )}
+                </div>
+              </div>
+            </div>
+
+            <div className="space-y-2">
+              <Label htmlFor="res-remarks">Remarks / Special Mentions (Optional)</Label>
+              <Textarea
+                id="res-remarks"
+                value={remarks}
+                onChange={(e) => setRemarks(e.target.value)}
+                placeholder="e.g. Declared by Diocese Kalolsavam Committee. Verified by Chief Judge."
+                rows={2}
+                className="text-xs"
+              />
+            </div>
+
+            <div className="flex items-center justify-between p-3 border rounded-xl bg-muted/20">
+              <div>
+                <Label htmlFor="res-publish" className="cursor-pointer font-medium text-sm">
+                  Publish to Participants Immediately
+                </Label>
+                <p className="text-xs text-muted-foreground">
+                  When enabled, participants can view & download this result PDF in the app right away.
+                </p>
+              </div>
+              <Switch id="res-publish" checked={isPublished} onCheckedChange={setIsPublished} />
+            </div>
+          </div>
+
+          <DialogFooter>
+            <Button
+              type="button"
+              variant="outline"
+              onClick={() => onOpenChange(false)}
+              disabled={uploading}
+            >
+              Cancel
+            </Button>
+            <Button
+              type="submit"
+              disabled={uploading || (resultType === "program" && programs.length === 0)}
+              className={resultType === "total" ? "bg-amber-600 hover:bg-amber-700 text-white" : ""}
+            >
+              {uploading && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}
+              {uploading
+                ? "Uploading PDF..."
+                : resultType === "total"
+                ? "🏆 Publish Total Result"
+                : "Publish Program Result"}
+            </Button>
+          </DialogFooter>
+        </form>
+      </DialogContent>
+    </Dialog>
+  );
+}
