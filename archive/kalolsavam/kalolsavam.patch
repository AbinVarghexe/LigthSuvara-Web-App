+import { useState, useEffect } from "react";
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "../../../components/ui/dialog";
+import { Button } from "../../../components/ui/button";
+import { Input } from "../../../components/ui/input";
+import { Label } from "../../../components/ui/label";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "../../../components/ui/select";
+import { KalolsavamProgram, KalolsavamStage, ProgramStatus } from "../types";
+import { createProgram, updateProgram } from "../services/kalolsavamService";
+import { toast } from "sonner";
+import { Loader2 } from "lucide-react";
+
+interface ProgramFormDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  program: KalolsavamProgram | null;
+  stages: KalolsavamStage[];
+  defaultStageId?: string;
+}
+
+const CATEGORIES = [
+  "Sub-Junior",
+  "Junior",
+  "Senior",
+  "Super Senior",
+  "General",
+  "Common",
+];
+
+export function ProgramFormDialog({
+  open,
+  onOpenChange,
+  program,
+  stages,
+  defaultStageId,
+}: ProgramFormDialogProps) {
+  const [title, setTitle] = useState("");
+  const [code, setCode] = useState("");
+  const [category, setCategory] = useState("Junior");
+  const [stageId, setStageId] = useState("");
+  const [orderInStage, setOrderInStage] = useState<number>(1);
+  const [scheduledTime, setScheduledTime] = useState("");
+  const [totalParticipants, setTotalParticipants] = useState<number>(0);
+  const [status, setStatus] = useState<ProgramStatus>("upcoming");
+  const [loading, setLoading] = useState(false);
+
+  useEffect(() => {
+    if (program) {
+      setTitle(program.title || "");
+      setCode(program.code || "");
+      setCategory(program.category || "Junior");
+      setStageId(program.stageId || "");
+      setOrderInStage(program.orderInStage ?? 1);
+      setScheduledTime(program.scheduledTime || "");
+      setTotalParticipants(program.totalParticipants ?? 0);
+      setStatus(program.status || "upcoming");
+    } else {
+      setTitle("");
+      setCode("");
+      setCategory("Junior");
+      setStageId(defaultStageId || (stages[0]?.id ?? ""));
+      setOrderInStage(1);
+      setScheduledTime("");
+      setTotalParticipants(0);
+      setStatus("upcoming");
+    }
+  }, [program, defaultStageId, stages, open]);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!title.trim()) {
+      toast.error("Please enter a program title");
+      return;
+    }
+    if (!stageId) {
+      toast.error("Please assign a stage for this program");
+      return;
+    }
+
+    const selectedStage = stages.find((s) => s.id === stageId);
+    const stageName = selectedStage ? selectedStage.name : "";
+
+    setLoading(true);
+    try {
+      if (program) {
+        await updateProgram(program.id, {
+          title: title.trim(),
+          code: code.trim(),
+          category,
+          stageId,
+          stageName,
+          orderInStage: Number(orderInStage) || 1,
+          scheduledTime: scheduledTime.trim(),
+          totalParticipants: Number(totalParticipants) || 0,
+          status,
+        });
+        toast.success("Program updated successfully!");
+      } else {
+        await createProgram({
+          title: title.trim(),
+          code: code.trim(),
+          category,
+          stageId,
+          stageName,
+          orderInStage: Number(orderInStage) || 1,
+          scheduledTime: scheduledTime.trim(),
+          totalParticipants: Number(totalParticipants) || 0,
+          currentChestNumber: "-",
+          status,
+          isResultPublished: false,
+        });
+        toast.success("Program added successfully!");
+      }
+      onOpenChange(false);
+    } catch (err: any) {
+      console.error(err);
+      toast.error(err?.message || "Failed to save program");
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-[500px]">
+        <form onSubmit={handleSubmit}>
+          <DialogHeader>
+            <DialogTitle>{program ? "Edit Competition Program" : "Add Competition Program"}</DialogTitle>
+          </DialogHeader>
+
+          <div className="space-y-4 py-4">
+            <div className="space-y-2">
+              <Label htmlFor="prog-title">Program Title / Item Name *</Label>
+              <Input
+                id="prog-title"
+                value={title}
+                onChange={(e) => setTitle(e.target.value)}
+                placeholder="e.g. Margamkali, Bharatanatyam, Elocution Malayalam"
+                required
+              />
+            </div>
+
+            <div className="grid grid-cols-2 gap-3">
+              <div className="space-y-2">
+                <Label htmlFor="prog-stage">Assigned Stage *</Label>
+                <Select value={stageId} onValueChange={setStageId}>
+                  <SelectTrigger id="prog-stage">
+                    <SelectValue placeholder="Choose stage" />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {stages.map((s) => (
+                      <SelectItem key={s.id} value={s.id}>
+                        {s.name}
+                      </SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+              </div>
+
+              <div className="space-y-2">
+                <Label htmlFor="prog-category">Category</Label>
+                <Select value={category} onValueChange={setCategory}>
+                  <SelectTrigger id="prog-category">
+                    <SelectValue placeholder="Category" />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {CATEGORIES.map((cat) => (
+                      <SelectItem key={cat} value={cat}>
+                        {cat}
+                      </SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+              </div>
+            </div>
+
+            <div className="grid grid-cols-3 gap-3">
+              <div className="space-y-2">
+                <Label htmlFor="prog-order">Order in Stage</Label>
+                <Input
+                  id="prog-order"
+                  type="number"
+                  min={1}
+                  value={orderInStage}
+                  onChange={(e) => setOrderInStage(parseInt(e.target.value) || 1)}
+                />
+              </div>
+
+              <div className="space-y-2">
+                <Label htmlFor="prog-time">Time</Label>
+                <Input
+                  id="prog-time"
+                  value={scheduledTime}
+                  onChange={(e) => setScheduledTime(e.target.value)}
+                  placeholder="e.g. 10:30 AM"
+                />
+              </div>
+
+              <div className="space-y-2">
+                <Label htmlFor="prog-participants">Participants</Label>
+                <Input
+                  id="prog-participants"
+                  type="number"
+                  min={0}
+                  value={totalParticipants}
+                  onChange={(e) => setTotalParticipants(parseInt(e.target.value) || 0)}
+                  placeholder="Count"
+                />
+              </div>
+            </div>
+
+            <div className="space-y-2">
+              <Label htmlFor="prog-status">Current Status</Label>
+              <Select value={status} onValueChange={(val: ProgramStatus) => setStatus(val)}>
+                <SelectTrigger id="prog-status">
+                  <SelectValue placeholder="Status" />
+                </SelectTrigger>
+                <SelectContent>
+                  <SelectItem value="upcoming">Upcoming</SelectItem>
+                  <SelectItem value="ongoing">Ongoing (Live)</SelectItem>
+                  <SelectItem value="completed">Completed</SelectItem>
+                  <SelectItem value="results_published">Results Published</SelectItem>
+                </SelectContent>
+              </Select>
+            </div>
+          </div>
+
+          <DialogFooter>
+            <Button
+              type="button"
+              variant="outline"
+              onClick={() => onOpenChange(false)}
+              disabled={loading}
+            >
+              Cancel
+            </Button>
+            <Button type="submit" disabled={loading}>
+              {loading && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}
+              {program ? "Save Changes" : "Add Program"}
+            </Button>
+          </DialogFooter>
+        </form>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/src/features/kalolsavam/components/ResultUploadDialog.tsx b/src/features/kalolsavam/components/ResultUploadDialog.tsx
new file mode 100644
index 0000000..8cdf2da
