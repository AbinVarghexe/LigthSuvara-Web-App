+  serverTimestamp,
+  Unsubscribe,
+} from "firebase/firestore";
+import { db } from "../../../config/firebase";
+import {
+  KalolsavamSettings,
+  KalolsavamStage,
+  KalolsavamProgram,
+  KalolsavamUser,
+  KalolsavamResult,
+} from "../types";
+import { uploadFile } from "../../../lib/upload";
+
+const SETTINGS_DOC_ID = "kalolsavam_settings";
+const SETTINGS_COLLECTION = "settings";
+const STAGES_COLLECTION = "kalolsavam_stages";
+const PROGRAMS_COLLECTION = "kalolsavam_programs";
+const USERS_COLLECTION = "kalolsavam_users";
+const RESULTS_COLLECTION = "kalolsavam_results";
+
+// ----------------- SETTINGS -----------------
+
+export const getKalolsavamSettings = async (): Promise<KalolsavamSettings> => {
+  const docRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+  const snap = await getDoc(docRef);
+  if (snap.exists()) {
+    return { id: snap.id, ...snap.data() } as KalolsavamSettings;
+  }
+  return {
+    isActive: false,
+    festivalName: "Diocesan Kalolsavam",
+    academicYear: "2025-2026",
+    festivalDate: new Date().toISOString().split("T")[0],
+    venue: "Main Campus Grounds",
+    announcement: "Welcome to Kalolsavam! Live stage updates will be shown below.",
+  };
+};
+
+export const saveKalolsavamSettings = async (
+  settings: Partial<KalolsavamSettings>
+): Promise<void> => {
+  const docRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+  await setDoc(
+    docRef,
+    {
+      ...settings,
+      updatedAt: serverTimestamp(),
+    },
+    { merge: true }
+  );
+};
+
+export const toggleKalolsavamActive = async (isActive: boolean): Promise<void> => {
+  const docRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+  await setDoc(docRef, { isActive, updatedAt: serverTimestamp() }, { merge: true });
+};
+
+export const subscribeKalolsavamSettings = (
+  callback: (settings: KalolsavamSettings) => void
+): Unsubscribe => {
+  const docRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+  return onSnapshot(docRef, (snap) => {
+    if (snap.exists()) {
+      callback({ id: snap.id, ...snap.data() } as KalolsavamSettings);
+    } else {
+      callback({
+        isActive: false,
+        festivalName: "Diocesan Kalolsavam",
+        announcement: "Kalolsavam is currently offline.",
+      });
+    }
+  });
+};
+
+// ----------------- STAGES -----------------
+
+export const getStages = async (): Promise<KalolsavamStage[]> => {
+  const q = query(collection(db, STAGES_COLLECTION), orderBy("order", "asc"));
+  const snap = await getDocs(q);
+  return snap.docs.map((d) => ({ id: d.id, ...d.data() } as KalolsavamStage));
+};
+
+export const subscribeStages = (
+  callback: (stages: KalolsavamStage[]) => void
+): Unsubscribe => {
+  const q = query(collection(db, STAGES_COLLECTION), orderBy("order", "asc"));
+  return onSnapshot(q, (snap) => {
+    const list = snap.docs.map((d) => ({ id: d.id, ...d.data() } as KalolsavamStage));
+    callback(list);
+  });
+};
+
+export const createStage = async (
+  stage: Omit<KalolsavamStage, "id" | "lastUpdated">
+): Promise<string> => {
+  const docRef = await addDoc(collection(db, STAGES_COLLECTION), {
+    ...stage,
+    lastUpdated: serverTimestamp(),
+  });
+  return docRef.id;
+};
+
+export const updateStage = async (
+  stageId: string,
+  data: Partial<KalolsavamStage>
+): Promise<void> => {
+  const docRef = doc(db, STAGES_COLLECTION, stageId);
+  await updateDoc(docRef, {
+    ...data,
+    lastUpdated: serverTimestamp(),
+  });
+};
+
+export const deleteStage = async (stageId: string): Promise<void> => {
+  const docRef = doc(db, STAGES_COLLECTION, stageId);
+  await deleteDoc(docRef);
+};
+
+export const updateStageChestNumber = async (
+  stageId: string,
+  chestNumber: string,
+  nextChestNumber?: string,
+  stageNote?: string,
+  programId?: string,
+  updatedBy?: string
+): Promise<void> => {
+  const docRef = doc(db, STAGES_COLLECTION, stageId);
+  const updatePayload: Record<string, any> = {
+    currentChestNumber: chestNumber,
+    lastUpdated: serverTimestamp(),
+  };
+  if (nextChestNumber !== undefined) updatePayload.nextChestNumber = nextChestNumber;
+  if (stageNote !== undefined) updatePayload.stageNote = stageNote;
+  if (programId !== undefined) updatePayload.currentProgramId = programId;
+  if (updatedBy) updatePayload.lastUpdatedBy = updatedBy;
+
+  await updateDoc(docRef, updatePayload);
+
+  // If a program is linked, also update the program's current chest number
+  if (programId) {
+    const progDocRef = doc(db, PROGRAMS_COLLECTION, programId);
+    await updateDoc(progDocRef, {
+      currentChestNumber: chestNumber,
+      status: "ongoing",
+      updatedAt: serverTimestamp(),
+    }).catch(() => {});
+  }
+};
+
+// ----------------- PROGRAMS -----------------
+
+export const getPrograms = async (): Promise<KalolsavamProgram[]> => {
+  const q = query(collection(db, PROGRAMS_COLLECTION), orderBy("orderInStage", "asc"));
+  const snap = await getDocs(q);
+  return snap.docs.map((d) => ({ id: d.id, ...d.data() } as KalolsavamProgram));
+};
+
+export const subscribePrograms = (
+  callback: (programs: KalolsavamProgram[]) => void
+): Unsubscribe => {
+  const q = query(collection(db, PROGRAMS_COLLECTION), orderBy("orderInStage", "asc"));
+  return onSnapshot(q, (snap) => {
+    const list = snap.docs.map((d) => ({ id: d.id, ...d.data() } as KalolsavamProgram));
+    callback(list);
+  });
+};
+
+export const createProgram = async (
+  program: Omit<KalolsavamProgram, "id" | "createdAt" | "updatedAt">
+): Promise<string> => {
+  const docRef = await addDoc(collection(db, PROGRAMS_COLLECTION), {
+    ...program,
+    createdAt: serverTimestamp(),
+    updatedAt: serverTimestamp(),
+  });
+  return docRef.id;
+};
+
+export const updateProgram = async (
+  programId: string,
+  data: Partial<KalolsavamProgram>
+): Promise<void> => {
+  const docRef = doc(db, PROGRAMS_COLLECTION, programId);
+  await updateDoc(docRef, {
+    ...data,
+    updatedAt: serverTimestamp(),
+  });
+};
+
+export const deleteProgram = async (programId: string): Promise<void> => {
+  const docRef = doc(db, PROGRAMS_COLLECTION, programId);
+  await deleteDoc(docRef);
+};
+
+// ----------------- USERS / STAGE MANAGERS -----------------
+
+export const getKalolsavamUsers = async (): Promise<KalolsavamUser[]> => {
+  const snap = await getDocs(collection(db, USERS_COLLECTION));
+  return snap.docs.map((d) => ({ id: d.id, ...d.data() } as KalolsavamUser));
+};
+
+export const subscribeKalolsavamUsers = (
+  callback: (users: KalolsavamUser[]) => void
+): Unsubscribe => {
+  return onSnapshot(collection(db, USERS_COLLECTION), (snap) => {
+    const list = snap.docs.map((d) => ({ id: d.id, ...d.data() } as KalolsavamUser));
+    callback(list);
+  });
+};
+
+import { bulkCreateUsers } from "../../users/services/userService";
+
+export const createKalolsavamUser = async (
+  user: Omit<KalolsavamUser, "id" | "createdAt">,
+  password?: string
+): Promise<string> => {
+  let createdUid: string | undefined;
+
+  // If password is provided, securely create the Firebase Auth login using Cloud Function
+  if (user.email && password) {
+    const authResult = await bulkCreateUsers([
+      {
+        email: user.email,
+        password: password,
+        name: user.name,
+        fullName: user.name,
+        phoneNumber: user.phone || "",
+        role: "stage_manager" as any,
+      } as any,
+    ]);
+
+    if (!authResult.success) {
+      const err = authResult.errors?.[0]?.error || "Failed to create user login credentials";
+      // If user already exists in auth, we can still link them
+      if (!err.toLowerCase().includes("already-exists") && !err.toLowerCase().includes("already in use")) {
+        throw new Error(err);
+      }
+    }
+
+    // Lookup user by email to get UID
+    const q = query(collection(db, "users"), where("email", "==", user.email));
+    const snap = await getDocs(q);
+    if (!snap.empty) {
+      createdUid = snap.docs[0].id;
+      await setDoc(doc(db, "users", createdUid), {
+        fullName: user.name,
+        name: user.name,
+        email: user.email,
+        phoneNumber: user.phone || "",
+        role: "stage_manager",
+        assignedStageIds: user.assignedStageIds,
+        assignedStageNames: user.assignedStageNames,
+        assignedProgramIds: user.assignedProgramIds,
+        assignedProgramNames: user.assignedProgramNames,
+        updatedAt: serverTimestamp(),
+      }, { merge: true });
+    }
+  }
+
+  // Create kalolsavam_users record
+  const docRef = await addDoc(collection(db, USERS_COLLECTION), {
+    ...user,
+    uid: createdUid || "",
+    createdAt: serverTimestamp(),
+  });
+
+  return docRef.id;
+};
+
+export const updateKalolsavamUser = async (
+  userId: string,
+  data: Partial<KalolsavamUser>
+): Promise<void> => {
+  const docRef = doc(db, USERS_COLLECTION, userId);
+  await updateDoc(docRef, data);
+
+  // Sync to root users collection
+  try {
+    const rootUserRef = doc(db, "users", userId);
+    await updateDoc(rootUserRef, data);
+  } catch (e) {
+    // Non-blocking
+  }
+};
+
+export const deleteKalolsavamUser = async (userId: string): Promise<void> => {
+  const docRef = doc(db, USERS_COLLECTION, userId);
+  await deleteDoc(docRef);
+
+  try {
+    await deleteDoc(doc(db, "users", userId));
+  } catch (e) {
+    // Non-blocking
+  }
+};
+
+// ----------------- RESULTS & PDF UPLOAD -----------------
+
+export const getKalolsavamResults = async (): Promise<KalolsavamResult[]> => {
+  const q = query(collection(db, RESULTS_COLLECTION), orderBy("uploadedAt", "desc"));
+  const snap = await getDocs(q);
+  return snap.docs.map((d) => ({ id: d.id, ...d.data() } as KalolsavamResult));
+};
+
+export const subscribeKalolsavamResults = (
+  callback: (results: KalolsavamResult[]) => void
+): Unsubscribe => {
+  const q = query(collection(db, RESULTS_COLLECTION), orderBy("uploadedAt", "desc"));
+  return onSnapshot(q, (snap) => {
+    const list = snap.docs.map((d) => ({ id: d.id, ...d.data() } as KalolsavamResult));
+    callback(list);
+  });
+};
+
+export const uploadResultPdf = async (
+  file: File,
+  meta: {
+    programId: string;
+    programTitle: string;
+    category?: string;
+    stageId?: string;
+    stageName?: string;
+    isPublished?: boolean;
+    remarks?: string;
+    uploadedBy?: string;
+  }
+): Promise<string> => {
+  const path = `kalolsavam_results/${Date.now()}_${file.name.replace(/\s+/g, "_")}`;
+  const pdfUrl = await uploadFile(file, path);
+
+  const resultDoc: Omit<KalolsavamResult, "id"> = {
+    programId: meta.programId,
+    programTitle: meta.programTitle,
+    category: meta.category || "",
+    stageId: meta.stageId || "",
+    stageName: meta.stageName || "",
+    pdfUrl,
+    pdfName: file.name,
+    fileSize: file.size,
+    isPublished: meta.isPublished ?? true,
+    remarks: meta.remarks || "",
+    uploadedAt: serverTimestamp(),
+    uploadedBy: meta.uploadedBy || "Admin",
+  };
+
+  const docRef = await addDoc(collection(db, RESULTS_COLLECTION), resultDoc);
+
+  // Also link to the program document so participants find it immediately on the program card
+  if (meta.programId) {
+    await updateProgram(meta.programId, {
+      resultPdfUrl: pdfUrl,
+      resultPdfName: file.name,
+      resultUploadedAt: serverTimestamp(),
+      isResultPublished: meta.isPublished ?? true,
+      status: "results_published",
+    });
+  }
+
+  return docRef.id;
+};
+
+export const uploadTotalResultPdf = async (
+  file: File,
+  meta: {
+    title?: string;
+    isPublished?: boolean;
+    remarks?: string;
+    uploadedBy?: string;
+  }
+): Promise<string> => {
+  const path = `kalolsavam_results/TOTAL_${Date.now()}_${file.name.replace(/\s+/g, "_")}`;
+  const pdfUrl = await uploadFile(file, path);
+
+  const title = meta.title?.trim() || "ആകെ ഫലം (Overall Championship / Total Points)";
+  const isPublished = meta.isPublished ?? true;
+
+  // 1. Sync to settings doc (immediate global availability)
+  const settingsRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+  await setDoc(
+    settingsRef,
+    {
+      totalResultPdfUrl: pdfUrl,
+      totalResultPdfName: file.name,
+      totalResultTitle: title,
+      isTotalResultPublished: isPublished,
+      totalResultUploadedAt: serverTimestamp(),
+      updatedAt: serverTimestamp(),
+    },
+    { merge: true }
+  );
+
+  // 2. Add or update in RESULTS_COLLECTION for unified results listing
+  const q = query(collection(db, RESULTS_COLLECTION), where("resultType", "==", "total"));
+  const existingSnap = await getDocs(q);
+  let docId: string;
+
+  const resultData: Omit<KalolsavamResult, "id"> = {
+    resultType: "total",
+    programId: "OVERALL_TOTAL",
+    programTitle: title,
+    category: "Overall Championship",
+    stageId: "",
+    stageName: "All Stages / General",
+    pdfUrl,
+    pdfName: file.name,
+    fileSize: file.size,
+    isPublished,
+    remarks: meta.remarks || "",
+    uploadedAt: serverTimestamp(),
+    uploadedBy: meta.uploadedBy || "Admin",
+  };
+
+  if (!existingSnap.empty) {
+    docId = existingSnap.docs[0].id;
+    await updateDoc(doc(db, RESULTS_COLLECTION, docId), resultData);
+  } else {
+    const docRef = await addDoc(collection(db, RESULTS_COLLECTION), resultData);
+    docId = docRef.id;
+  }
+
+  return docId;
+};
+
+export const toggleTotalResultPublished = async (isPublished: boolean): Promise<void> => {
+  const settingsRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+  await updateDoc(settingsRef, {
+    isTotalResultPublished: isPublished,
+    updatedAt: serverTimestamp(),
+  });
+
+  const q = query(collection(db, RESULTS_COLLECTION), where("resultType", "==", "total"));
+  const snap = await getDocs(q);
+  for (const d of snap.docs) {
+    await updateDoc(doc(db, RESULTS_COLLECTION, d.id), { isPublished });
+  }
+};
+
+export const removeTotalResultPdf = async (): Promise<void> => {
+  const settingsRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+  await updateDoc(settingsRef, {
+    totalResultPdfUrl: null,
+    totalResultPdfName: null,
+    isTotalResultPublished: false,
+    updatedAt: serverTimestamp(),
+  });
+
+  const q = query(collection(db, RESULTS_COLLECTION), where("resultType", "==", "total"));
+  const snap = await getDocs(q);
+  for (const d of snap.docs) {
+    await deleteDoc(doc(db, RESULTS_COLLECTION, d.id));
+  }
+};
+
+export const toggleResultPublished = async (
+  resultId: string,
+  isPublished: boolean,
+  programId?: string,
+  resultType?: string
+): Promise<void> => {
+  const docRef = doc(db, RESULTS_COLLECTION, resultId);
+  await updateDoc(docRef, { isPublished });
+
+  if (resultType === "total" || programId === "OVERALL_TOTAL") {
+    const settingsRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+    await updateDoc(settingsRef, {
+      isTotalResultPublished: isPublished,
+      updatedAt: serverTimestamp(),
+    });
+  } else if (programId) {
+    await updateProgram(programId, { isResultPublished: isPublished });
+  }
+};
+
+export const deleteKalolsavamResult = async (
+  resultId: string,
+  programId?: string,
+  resultType?: string
+): Promise<void> => {
+  const docRef = doc(db, RESULTS_COLLECTION, resultId);
+  await deleteDoc(docRef);
+
+  if (resultType === "total" || programId === "OVERALL_TOTAL") {
+    const settingsRef = doc(db, SETTINGS_COLLECTION, SETTINGS_DOC_ID);
+    await updateDoc(settingsRef, {
+      totalResultPdfUrl: null,
+      totalResultPdfName: null,
+      isTotalResultPublished: false,
+      updatedAt: serverTimestamp(),
+    });
+  } else if (programId) {
+    await updateProgram(programId, {
+      resultPdfUrl: null,
+      resultPdfName: null,
+      isResultPublished: false,
+    });
+  }
+};
+
