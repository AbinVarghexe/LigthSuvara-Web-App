@@ -0,0 +1,440 @@
+import { useState } from "react";
+import { KalolsavamStage, KalolsavamProgram, KalolsavamResult, KalolsavamSettings } from "../types";
+import { Card, CardContent } from "../../../components/ui/card";
+import { Badge } from "../../../components/ui/badge";
+import { Button } from "../../../components/ui/button";
+import { Input } from "../../../components/ui/input";
+import {
+  Search,
+  Radio,
+  FileText,
+  Download,
+  ExternalLink,
+  MapPin,
+  Clock,
+  Users,
+  Trophy,
+  Megaphone,
+  Pause,
+  CheckCircle2,
+  Sparkles,
+  Layers,
+} from "lucide-react";
+
+interface LiveDisplayBoardProps {
+  settings: KalolsavamSettings | null;
+  stages: KalolsavamStage[];
+  programs: KalolsavamProgram[];
+  results: KalolsavamResult[];
+  isPublic?: boolean;
+}
+
+export function LiveDisplayBoard({
+  settings,
+  stages,
+  programs,
+  results,
+  isPublic = false,
+}: LiveDisplayBoardProps) {
+  const [selectedStageId, setSelectedStageId] = useState<string>("all");
+  const [searchQuery, setSearchQuery] = useState("");
+  const [activeTab, setActiveTab] = useState<"stages" | "programs" | "results">("stages");
+
+  // Filter programs based on stage & search
+  const filteredPrograms = programs.filter((p) => {
+    const matchesStage = selectedStageId === "all" || p.stageId === selectedStageId;
+    const matchesSearch =
+      searchQuery === "" ||
+      p.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
+      p.category.toLowerCase().includes(searchQuery.toLowerCase()) ||
+      (p.stageName && p.stageName.toLowerCase().includes(searchQuery.toLowerCase()));
+    return matchesStage && matchesSearch;
+  });
+
+  // Filter stages based on selection
+  const filteredStages =
+    selectedStageId === "all"
+      ? stages
+      : stages.filter((s) => s.id === selectedStageId);
+
+  // Published results
+  const publishedResults = results.filter((r) => r.isPublished);
+
+  const getStatusBadge = (status: string) => {
+    switch (status) {
+      case "active":
+      case "ongoing":
+        return (
+          <Badge className="bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 gap-1.5 animate-pulse font-semibold">
+            <span className="h-2 w-2 rounded-full bg-emerald-500" />
+            LIVE ON STAGE
+          </Badge>
+        );
+      case "break":
+        return (
+          <Badge className="bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 gap-1.5 font-semibold">
+            <Pause className="w-3 h-3" />
+            ON BREAK
+          </Badge>
+        );
+      case "completed":
+        return (
+          <Badge className="bg-muted text-muted-foreground border gap-1.5">
+            <CheckCircle2 className="w-3 h-3" />
+            CONCLUDED
+          </Badge>
+        );
+      case "results_published":
+        return (
+          <Badge className="bg-purple-500/20 text-purple-600 dark:text-purple-400 border border-purple-500/30 gap-1.5 font-semibold">
+            <Trophy className="w-3 h-3" />
+            RESULTS PUBLISHED
+          </Badge>
+        );
+      default:
+        return (
+          <Badge variant="outline" className="text-muted-foreground gap-1.5">
+            <Clock className="w-3 h-3" />
+            SCHEDULED
+          </Badge>
+        );
+    }
+  };
+
+  return (
+    <div className="space-y-6">
+      {/* Announcement Marquee / Banner if active */}
+      {settings?.announcement && (
+        <div className="bg-gradient-to-r from-amber-500/15 via-primary/10 to-amber-500/15 border border-amber-500/30 text-amber-900 dark:text-amber-200 px-4 py-2.5 rounded-xl flex items-center gap-3 shadow-xs">
+          <Megaphone className="w-4 h-4 shrink-0 text-amber-500 animate-bounce" />
+          <div className="overflow-hidden whitespace-nowrap text-xs md:text-sm font-medium">
+            <span>{settings.announcement}</span>
+          </div>
+        </div>
+      )}
+
+      {/* Control Bar: Tabs, Stage Filter, Search */}
+      <div className="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
+        <div className="flex bg-muted/60 p-1 rounded-xl border border-border">
+          <button
+            onClick={() => setActiveTab("stages")}
+            className={`px-4 py-2 text-xs font-semibold rounded-lg transition-all flex items-center gap-2 cursor-pointer ${
+              activeTab === "stages"
+                ? "bg-background text-primary shadow-xs"
+                : "text-muted-foreground hover:text-foreground"
+            }`}
+          >
+            <Radio className="w-3.5 h-3.5" />
+            Live Stages ({stages.length})
+          </button>
+          <button
+            onClick={() => setActiveTab("programs")}
+            className={`px-4 py-2 text-xs font-semibold rounded-lg transition-all flex items-center gap-2 cursor-pointer ${
+              activeTab === "programs"
+                ? "bg-background text-primary shadow-xs"
+                : "text-muted-foreground hover:text-foreground"
+            }`}
+          >
+            <Layers className="w-3.5 h-3.5" />
+            All Programs ({programs.length})
+          </button>
+          <button
+            onClick={() => setActiveTab("results")}
+            className={`px-4 py-2 text-xs font-semibold rounded-lg transition-all flex items-center gap-2 cursor-pointer ${
+              activeTab === "results"
+                ? "bg-background text-primary shadow-xs"
+                : "text-muted-foreground hover:text-foreground"
+            }`}
+          >
+            <Trophy className="w-3.5 h-3.5" />
+            Results PDFs ({publishedResults.length})
+          </button>
+        </div>
+
+        <div className="flex flex-col sm:flex-row gap-2.5 items-center">
+          {/* Stage Filter */}
+          <div className="flex items-center gap-1.5 overflow-x-auto max-w-full pb-1 sm:pb-0">
+            <Button
+              variant={selectedStageId === "all" ? "default" : "outline"}
+              size="sm"
+              onClick={() => setSelectedStageId("all")}
+              className="text-xs h-8 rounded-lg"
+            >
+              All Stages
+            </Button>
+            {stages.map((stg) => (
+              <Button
+                key={stg.id}
+                variant={selectedStageId === stg.id ? "default" : "outline"}
+                size="sm"
+                onClick={() => setSelectedStageId(stg.id)}
+                className="text-xs h-8 rounded-lg shrink-0"
+              >
+                {stg.shortCode || stg.name}
+              </Button>
+            ))}
+          </div>
+
+          {/* Search Box */}
+          <div className="relative w-full sm:w-56">
+            <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground" />
+            <Input
+              value={searchQuery}
+              onChange={(e) => setSearchQuery(e.target.value)}
+              placeholder="Search program..."
+              className="pl-9 h-8 text-xs rounded-lg"
+            />
+          </div>
+        </div>
+      </div>
+
+      {/* TAB 1: LIVE STAGES VIEW */}
+      {activeTab === "stages" && (
+        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
+          {filteredStages.length === 0 ? (
+            <div className="col-span-full text-center py-12 border rounded-xl bg-card">
+              <Radio className="w-8 h-8 text-muted-foreground mx-auto mb-2 opacity-50" />
