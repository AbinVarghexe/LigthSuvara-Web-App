@@ -0,0 +1,174 @@
+import { useState, useEffect } from "react";
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "../../../components/ui/dialog";
+import { Button } from "../../../components/ui/button";
+import { Input } from "../../../components/ui/input";
+import { Label } from "../../../components/ui/label";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "../../../components/ui/select";
+import { KalolsavamStage, StageStatus } from "../types";
+import { createStage, updateStage } from "../services/kalolsavamService";
+import { toast } from "sonner";
+import { Loader2 } from "lucide-react";
+
+interface StageFormDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  stage: KalolsavamStage | null;
+  totalStagesCount: number;
+}
+
+export function StageFormDialog({
+  open,
+  onOpenChange,
+  stage,
+  totalStagesCount,
+}: StageFormDialogProps) {
+  const [name, setName] = useState("");
+  const [shortCode, setShortCode] = useState("");
+  const [location, setLocation] = useState("");
+  const [order, setOrder] = useState<number>(1);
+  const [status, setStatus] = useState<StageStatus>("active");
+  const [loading, setLoading] = useState(false);
+
+  useEffect(() => {
+    if (stage) {
+      setName(stage.name || "");
+      setShortCode(stage.shortCode || "");
+      setLocation(stage.location || "");
+      setOrder(stage.order ?? 1);
+      setStatus(stage.status || "active");
+    } else {
+      setName("");
+      setShortCode(`Stage ${totalStagesCount + 1}`);
+      setLocation("");
+      setOrder(totalStagesCount + 1);
+      setStatus("active");
+    }
+  }, [stage, totalStagesCount, open]);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!name.trim()) {
+      toast.error("Please provide a stage name");
+      return;
+    }
+
+    setLoading(true);
+    try {
+      if (stage) {
+        await updateStage(stage.id, {
+          name: name.trim(),
+          shortCode: shortCode.trim(),
+          location: location.trim(),
+          order: Number(order) || 1,
+          status,
+        });
+        toast.success("Stage updated successfully!");
+      } else {
+        await createStage({
+          name: name.trim(),
+          shortCode: shortCode.trim(),
+          location: location.trim(),
+          order: Number(order) || totalStagesCount + 1,
+          status,
+          currentChestNumber: "-",
+          nextChestNumber: "-",
+          assignedUserIds: [],
+        });
+        toast.success("Stage created successfully!");
+      }
+      onOpenChange(false);
+    } catch (err: any) {
+      console.error(err);
+      toast.error(err?.message || "Failed to save stage");
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-[480px]">
+        <form onSubmit={handleSubmit}>
+          <DialogHeader>
+            <DialogTitle>{stage ? "Edit Stage" : "Add New Stage"}</DialogTitle>
+          </DialogHeader>
+
+          <div className="space-y-4 py-4">
+            <div className="space-y-2">
+              <Label htmlFor="stage-name">Stage Name *</Label>
+              <Input
+                id="stage-name"
+                value={name}
+                onChange={(e) => setName(e.target.value)}
+                placeholder="e.g. Stage 1 - Main Auditorium"
+                required
+              />
+            </div>
+
+            <div className="grid grid-cols-2 gap-3">
+              <div className="space-y-2">
+                <Label htmlFor="stage-code">Short Code / Label</Label>
+                <Input
+                  id="stage-code"
+                  value={shortCode}
+                  onChange={(e) => setShortCode(e.target.value)}
+                  placeholder="e.g. Stage 1"
+                />
+              </div>
+              <div className="space-y-2">
+                <Label htmlFor="stage-order">Display Order</Label>
+                <Input
+                  id="stage-order"
+                  type="number"
+                  min={1}
+                  value={order}
+                  onChange={(e) => setOrder(parseInt(e.target.value) || 1)}
+                />
+              </div>
+            </div>
+
+            <div className="space-y-2">
+              <Label htmlFor="stage-location">Location / Venue Description</Label>
+              <Input
+                id="stage-location"
+                value={location}
+                onChange={(e) => setLocation(e.target.value)}
+                placeholder="e.g. Main Block, Ground Floor"
+              />
+            </div>
+
+            <div className="space-y-2">
+              <Label htmlFor="stage-status">Stage Initial Status</Label>
+              <Select value={status} onValueChange={(val: StageStatus) => setStatus(val)}>
+                <SelectTrigger id="stage-status">
+                  <SelectValue placeholder="Select status" />
+                </SelectTrigger>
+                <SelectContent>
+                  <SelectItem value="active">Active (Ongoing)</SelectItem>
+                  <SelectItem value="break">On Break</SelectItem>
+                  <SelectItem value="paused">Paused</SelectItem>
+                  <SelectItem value="completed">Concluded</SelectItem>
+                </SelectContent>
+              </Select>
+            </div>
+          </div>
+
+          <DialogFooter>
+            <Button
+              type="button"
+              variant="outline"
+              onClick={() => onOpenChange(false)}
+              disabled={loading}
+            >
+              Cancel
+            </Button>
+            <Button type="submit" disabled={loading}>
+              {loading && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}
+              {stage ? "Save Changes" : "Create Stage"}
+            </Button>
+          </DialogFooter>
+        </form>
+      </DialogContent>
+    </Dialog>
+  );
+}
